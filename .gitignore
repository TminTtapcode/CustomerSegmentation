# Python / Virtual Environment
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env

# Temporary & Caches
.tmp/
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
.DS_Store
Thumbs.db

# Large Raw & Cleaned Datasets (> 100 MB, excluded from git per GitHub limit)
# Instructions to download and build are provided in README.md
data/raw/*.csv
data/cleaned/*.parquet
!data/raw/.gitkeep
!data/cleaned/.gitkeep
!data/processed/.gitkeep
!data/snapshots/.gitkeep

# Exclude compressed archives
*.zip
*.tar.gz
*.7z
